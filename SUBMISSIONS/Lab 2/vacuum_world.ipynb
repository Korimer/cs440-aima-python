    "def SimulatedAnnealingVacuumAgent():\n",
    "    temperature = 3\n",
    "    decay = .95\n",
    "    # ignore the evil type signature; its helpful for my typechecking engine\n",
    "    def program(percept: tuple[tuple[int,int],int,dict[str,int]]):\n",
    "        nonlocal temperature\n",
    "        temperature *= decay\n",
    "\n",
    "        location, curdirt, neighbors = percept\n",
    "        next_choice = random.choice(list(neighbors.keys()))\n",
    "\n",
    "        delta = neighbors[next_choice] - curdirt\n",
    "\n",
    "        if delta > 0 or random.random() < math.exp( delta / temperature ):\n",
    "            return next_choice\n",
    "        else:\n",
    "            return \"NoOp\"\n",
    "        # Normally I'd have an exit condition if the temperature gets too low\n",
    "        # But thats unecessary since the Agent only runs a finite, predetermined number of times\n",
    "\n",
    "\n",
    "    return Agent(program)\n",
    "\n",
    "\n",
    "env = VacuumEnvironment2d(gridValuesSA)\n",
    "agent = SimulatedAnnealingVacuumAgent()\n",
    "env.add_thing(agent)\n",
    "env.run()\n",
    "print(\"Final Score: \" + str(agent.performance))\n",
    "print(\"History:\")\n",
    "print(env.history)\n",
    "env.displayPathing()"
   ]
