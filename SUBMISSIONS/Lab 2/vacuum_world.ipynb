    "def HillClimbingVacuumAgent():\n",
    "    def program(percept):\n",
    "\n",
    "        # unpack percept\n",
    "        location, dirt_value, neighbours = percept \n",
    "\n",
    "        # get the max value of the neighbours\n",
    "        best = max(neighbours, key=neighbours.get)\n",
    "\n",
    "        # compare max value with current value and return action\n",
    "        if neighbours[best] > dirt_value:\n",
    "            action = best\n",
    "        else:\n",
    "            action = \"NoOp\"\n",
    "        return action\n",
    "\n",
    "    return Agent(program)\n",
